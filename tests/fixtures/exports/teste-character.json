        }
      ]
    },
    {
      "id": "srd:dwarf:dwarven-combat-training",
      "kind": "species-trait",
      "name": "Dwarven Combat Training",
      "source": "srd",
      "page": 5,
      "text": "You have proficiency with the battleaxe, handaxe, light hammer, and warhammer.",
      "provenance": {
        "via": [
          "srd:species:dwarf"
        ]
      },
      "parts": [
        {
          "kind": "passive",
          "from": "modifiers",
