      "kind": "class-feature",
      "name": "Divine Health",
      "source": "srd",
      "page": 29,
      "text": "By 3rd level, the divine magic flowing through you makes you immune to disease.",
      "provenance": {
        "class": "srd:class:paladin",
        "classLevel": 3,
        "via": [
          "srd:class:paladin"
        ]
      },
      "parts": [
