            "recharge": "long-rest",
            "unit": "hit points"
          }
        },
        {
          "kind": "action",
          "from": "actions",
          "definition": {
            "id": "lay-on-hands",
            "name": "Lay on Hands (heal)",
            "activation": "action",
            "cost": {
              "srd:paladin:lay-on-hands": {
                "min": 1,
                "max": 100
              }
            },
            "range": "Touch",
            "text": "Restore hit points equal to the amount you spend from the pool."
          }
        },
        {
          "kind": "action",
          "from": "actions",
          "definition": {
            "id": "lay-on-hands-cure",
            "name": "Lay on Hands (cure disease or poison)",
            "activation": "action",
