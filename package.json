{
  "name": "dragonglass-builder",
  "version": "0.2.0",
  "description": "A data-driven D&D 5e character builder and sheet for Obsidian.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "dev": "node scripts/bundle-content.mjs && node esbuild.config.mjs",
    "build": "node scripts/bundle-content.mjs && tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node scripts/bundle-content.mjs && vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -noEmit -skipLibCheck",
    "validate": "tsx src/cli/validate.ts",
    "bundle:content": "node scripts/bundle-content.mjs",
    "srd:outline": "node scripts/srd.mjs outline",
    "srd:section": "node scripts/srd.mjs section",
    "export:schema": "tsx scripts/export-schema.ts",
    "export": "tsx src/cli/export.ts"
  },
  "keywords": [
    "obsidian",
    "dnd",
    "5e"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "builtin-modules": "^4.0.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.14.4",
    "tslib": "^2.8.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@sinclair/typebox": "^0.34.52",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  }
}
